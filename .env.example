# ============================================
# WebSearchAi Configuration
# ============================================

# ── LLM Provider ─────────────────────────────────────────────────────────────
# auto | mistral | openai | anthropic | ollama
# "auto" picks the first provider with a valid API key in priority order:
# mistral → openai → anthropic → ollama
LLM_PROVIDER=auto

# Mistral (recommended — free tier at https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_TEXT_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409

# OpenAI (optional — https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (optional — https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Ollama local (optional — https://ollama.ai/, runs fully offline)
OLLAMA_BASE_URL=http://localhost:11434

# Browser settings
BROWSER_HEADLESS=false
BROWSER_TYPE=chromium
BROWSER_TIMEOUT=30000
BROWSER_VIEWPORT_WIDTH=1366
BROWSER_VIEWPORT_HEIGHT=768

# Stealth & human behavior
ENABLE_STEALTH=true
MIN_ACTION_DELAY_MS=300
MAX_ACTION_DELAY_MS=1200
HUMAN_TYPING_WPM=240

# Agent loop
MAX_STEPS_PER_TASK=40
MAX_RETRIES_PER_STEP=3

# ── Search backends ──────────────────────────────────────────────────────────
# auto = try Tavily (if key) then DuckDuckGo Lite. tavily / ddgs force one.
SEARCH_BACKEND=auto
# TAVILY_API_KEY=
SEARCH_MAX_RESULTS=8

# ── Search-first agentic research ────────────────────────────────────────────
# When the goal contains no http(s) URL, route through the SearchAgent:
# generate queries → search → rank → critique → visit top-K →
# judge content → (re-search if empty) → synthesize cited answer.
RESEARCH_ENABLED=true
RESEARCH_MAX_CANDIDATES=3
RESEARCH_MIN_USEFUL_SOURCES=2
RESEARCH_MAX_RE_SEARCH=2
RESEARCH_RELEVANCE_THRESHOLD=0.6
RESEARCH_HEURISTIC_WEIGHT=0.4

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Output
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# Optional: HTTP proxy
# HTTP_PROXY=http://user:pass@host:port
