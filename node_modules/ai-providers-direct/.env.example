# DeepSeek web-app auth token captured from chat.deepseek.com.
# Get one by signing into https://chat.deepseek.com once in the
# Playwright-managed Chrome profile, then:
#   npm run token:refresh:headed   # first time — sign in
#   npm run token:refresh          # subsequent — headless re-capture
#
# The script writes/updates this variable automatically. You only need to
# create the file (copy .env.example → .env).
DEEPSEEK_USER_TOKEN=7f2lCy763BDnpCmQ61hTdmEnXZf8cOucJpbQFs8j+Zf30jS+K86+/Z0MJpNnn7jd

# ChatGPT provider — no env var needed.
# The chatgpt provider uses a Playwright-managed Chrome profile (stored at
# .chatgpt-research/chrome-profile) and authenticates via the cookies saved
# in that profile. To set it up:
#   npm run chatgpt:setup        # opens a window — sign in once
#   npm run chatgpt:verify       # confirms the saved session is still valid
#   npm run chatgpt:example      # sends a test prompt

# Optional: log level for the bundled stub logger.
# One of: debug | info | warn | error (default: info)
LOG_LEVEL=info
