{
  "name": "ai-providers-direct",
  "version": "0.1.0",
  "description": "Direct HTTP transports for AI providers (DeepSeek today; OpenAI / Anthropic / Gemini next). Zero-extension, server-side.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deepseek": {
      "types": "./dist/providers/deepseek/index.d.ts",
      "import": "./dist/providers/deepseek/index.js"
    },
    "./chatgpt": {
      "types": "./dist/providers/chatgpt/index.d.ts",
      "import": "./dist/providers/chatgpt/index.js"
    },
    "./logger": {
      "types": "./dist/log/logger.d.ts",
      "import": "./dist/log/logger.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "example": "tsx --env-file=.env examples/basic.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "token:refresh": "node scripts/extract-ai-token.mjs --verbose",
    "token:refresh:headed": "node scripts/extract-ai-token.mjs --headed --verbose",
    "token:verify": "node scripts/extract-ai-token.mjs --verify --verbose",
    "token:bookmarklet": "node scripts/token-via-bookmarklet.mjs",
    "chatgpt:setup": "node scripts/extract-chatgpt-session.mjs --verbose",
    "chatgpt:verify": "node scripts/extract-chatgpt-session.mjs --verify --verbose",
    "chatgpt:example": "tsx examples/chatgpt.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "^1.48.0",
    "tsx": "^4.19.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "deepseek",
    "ai",
    "llm",
    "chat",
    "streaming",
    "sse",
    "pow"
  ]
}
